{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keloshell",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "PUSH_KV",
      "id": "7d64d6b1104044c383265478867b8e52",
      "preview_id": "81682f7da8954fa0b881f4b7b23b5bb7",
    },
  ],
  "vars": {
    "SHEETS_TARGET_LABEL": "replica",
    "CONNECTIVITY_SHEET_NAME": "_PWA_CONNECTIVITY",
    "CONNECTIVITY_SENTINEL": "KELOSHELL_CONNECTIVITY_V1",
    "ALLOW_CONNECTIVITY_WRITE_TEST": "true",
    "REMINDER_TIME_ZONE": "America/New_York",
    // Run: npx web-push generate-vapid-keys
    // Paste the Public Key below, then store the Private Key as a secret:
    //   npx wrangler pages secret put VAPID_PRIVATE_KEY
    "VAPID_PUBLIC_KEY": "BNYl33LuklS1NYrGhH1wi9SaWgeTabIHRVevlcuzA9j7D3SVFkd6q1i1M0DAKjiITtJHCy5jzzYSc4jjCoBYMik",
    "VAPID_SUBJECT": "mailto:eduardo.rubio.jr85@gmail.com",
    // Cloudflare Access emails → user identity (see functions/lib/users.ts).
    // Non-secret; kept here so preview/dev resolve the same users as production.
    "EDUARDO_EMAIL": "eduardo.rubio.jr85@gmail.com",
    "EMILY_EMAIL": "emily.marosek@gmail.com",
  },
  "env": {
    "production": {
      "kv_namespaces": [
        {
          "binding": "PUSH_KV",
          "id": "7d64d6b1104044c383265478867b8e52",
        },
      ],
      "vars": {
        "SHEETS_TARGET_LABEL": "source",
        "ALLOW_CONNECTIVITY_WRITE_TEST": "false",
        "REMINDER_TIME_ZONE": "America/New_York",
        "VAPID_PUBLIC_KEY": "BNYl33LuklS1NYrGhH1wi9SaWgeTabIHRVevlcuzA9j7D3SVFkd6q1i1M0DAKjiITtJHCy5jzzYSc4jjCoBYMik",
        "VAPID_SUBJECT": "mailto:eduardo.rubio.jr85@gmail.com",
        "EDUARDO_EMAIL": "eduardo.rubio.jr85@gmail.com",
        "EMILY_EMAIL": "emily.marosek@gmail.com",
        // Emily's own coach training-source spreadsheet and app-owned meta DB.
        // Eduardo's equivalents (GOOGLE_SPREADSHEET_ID / KELOSHELL_META_DB_SHEET)
        // stay as Cloudflare-managed values; runtime env merges both.
        "EMILY_GOOGLE_SPREADSHEET_ID": "1kA7F2KRGlL2TOKF06hSPrHdvdq54UrBkFO1cWXt7FHU",
        "EMILY_META_DB_SHEET": "1HOr8i6UY9UntT1e94O2y6zVfWEoH2wAj6hvffptFXBE",
      },
    },
  },
}
